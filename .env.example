# ─────────────────────────────────────────────────────────────
# Pulse / Reji — Environment template (V31)
# Copy:  cp .env.example .env.development
#        cp .env.example .env.production
# Never commit real secrets. Docker Compose reads these keys.
# ─────────────────────────────────────────────────────────────

# --- Runtime ---
NODE_ENV=development
APP_ENV=development
# Expo web (baked at `expo export` / docker web target)
EXPO_PUBLIC_APP_ENV=development

# --- HTTP / WebSocket ---
PORT=8080
HTTP_PORT=8080
HTTP_PUBLISH_PORT=8080
WEB_PUBLISH_PORT=3000
WS_PATH=/ws
WS_HOST=127.0.0.1
WS_PORT=8080
WS_SECURE=false
EXPO_PUBLIC_WS_HOST=127.0.0.1
EXPO_PUBLIC_WS_PORT=8080
EXPO_PUBLIC_WS_SECURE=false
EXPO_PUBLIC_WS_PATH=/ws

# --- Auth (JWT) ---
# REQUIRED in production — use a long random string
JWT_SECRET=reji-dev-only-change-me
EXPO_PUBLIC_JWT_SECRET=reji-dev-only-change-me
JWT_TTL_MS=43200000
EXPO_PUBLIC_JWT_TTL_MS=43200000
ADMIN_BOOTSTRAP_KEY=reji-admin-bootstrap-dev

# --- Redis (horizontal fanout) ---
REDIS_URL=redis://127.0.0.1:6379
REDIS_PUBLISH_PORT=6379

# --- PTP buffers (ms) ---
PTP_NETWORK_BUFFER_MS=80
EXPO_PUBLIC_PTP_NETWORK_BUFFER_MS=80
PTP_EMERGENCY_BUFFER_MS=25
PTP_BUFFER_MIN_MS=40
PTP_BUFFER_MAX_MS=250

# --- Zombie purge / heartbeat ---
WS_PING_INTERVAL_MS=5000
WS_PONG_TIMEOUT_MS=15000

# --- UDP multicast fallback (LAN) ---
UDP_MULTICAST_GROUP=239.255.90.1
UDP_MULTICAST_PORT=9090
EXPO_PUBLIC_UDP_MULTICAST_GROUP=239.255.90.1
EXPO_PUBLIC_UDP_MULTICAST_PORT=9090

# --- PM2 / cluster ---
# Instances per api/worker container (Node cluster via PM2)
WEB_CONCURRENCY=2
WORKER_WEB_CONCURRENCY=2
WORKER_REPLICAS=2
PM2_INSTANCES=2
PM2_MAX_MEMORY=1G
WORKER_ID=local-dev

# --- Load test (k6) ---
LOADTEST_BASE_URL=http://127.0.0.1:8080
LOADTEST_WS_URL=ws://127.0.0.1:8080/ws
LOADTEST_VUS=50000
LOADTEST_RAMP_UP=2m
LOADTEST_HOLD=5m
LOADTEST_RAMP_DOWN=1m
