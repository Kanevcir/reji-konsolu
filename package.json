{
  "name": "pulse-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~0.2.0-beta.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "ioredis": "^5.6.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "~19.2.2",
    "@types/ws": "^8.18.1",
    "pm2": "^6.0.8",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:web": "expo export -p web",
    "server:dev": "tsx --env-file=.env.development server/src/index.ts",
    "server:start": "pm2-runtime start server/ecosystem.config.cjs",
    "server:pm2": "pm2 start server/ecosystem.config.cjs",
    "test:ptp": "npx --yes tsx src/reji/simulations/runPtpOfflineSim.ts",
    "test:mapping": "npx --yes tsx src/reji/simulations/runSeatMappingSim.ts",
    "test:scale": "npx --yes tsx src/reji/simulations/runScaleSim.ts",
    "test:security": "npx --yes tsx src/reji/simulations/runSecuritySim.ts",
    "test:load": "k6 run load-test/load-test.js",
    "test:load:smoke": "node load-test/run-smoke.mjs",
    "test:load:smoke:k6": "k6 run -e LOADTEST_VUS=20 -e LOADTEST_RAMP_UP=5s -e LOADTEST_HOLD=15s -e LOADTEST_RAMP_DOWN=5s -e LOADTEST_SESSION_SEC=12 load-test/load-test.js",
    "docker:build": "docker compose build",
    "docker:up": "docker compose --env-file .env.example up --build -d",
    "typecheck": "tsc --noEmit -p .",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json"
  },
  "private": true,
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}
